---
/**
 * The personal mark: a trefoil knot (the hero's knot, simplified) with real
 * over/under crossings, tinted with the theme's chemistry → systems colors.
 */
import { trefoilMark, trefoilMarkup } from "@/shared/brand/trefoil";

interface Props {
  class?: string;
  /** Unique per page: the SVG gradient and mask need distinct ids. */
  id: string;
}

const { class: className, id } = Astro.props;
const mark = trefoilMark(40, 2.5);
const markup = trefoilMarkup(mark, { id });
---

<svg
  class:list={["brand-mark", className]}
  viewBox={mark.viewBox}
  aria-hidden="true"
  focusable="false"
  set:html={markup}
/>

<style>
  .brand-mark :global(.trefoil-from) {
    stop-color: var(--chem);
  }

  .brand-mark :global(.trefoil-to) {
    stop-color: var(--accent);
  }

  @media (forced-colors: active) {
    .brand-mark :global(stop) {
      stop-color: CanvasText;
    }
  }
</style>
