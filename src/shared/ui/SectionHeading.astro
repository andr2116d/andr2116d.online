---
interface Props {
  /** Two-digit section number shown as a mono label. */
  index: string;
  kicker: string;
  title: string;
  id: string;
  /** Heading level; sections use h2, standalone pages may use h1. */
  level?: 1 | 2;
}

const { index, kicker, title, id, level = 2 } = Astro.props;
const Heading = `h${level}` as "h1" | "h2";
---

<header class="section-heading">
  <p class="section-heading__kicker">
    <span class="section-heading__index" aria-hidden="true">
      {index}
    </span>
    <span>{kicker}</span>
  </p>
  <Heading id={id} class="section-heading__title">
    {title}
  </Heading>
  <slot />
</header>

<style>
  .section-heading {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
  }

  .section-heading__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .section-heading__index {
    display: inline-grid;
    place-items: center;
    min-inline-size: 2.25rem;
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.375rem;
    color: var(--accent);
  }

  .section-heading__title {
    font-size: var(--step-3);
  }

  .section-heading :global(p:not(.section-heading__kicker)) {
    font-size: var(--step-0);
    color: var(--text-muted);
    max-width: 40rem;
  }
</style>
