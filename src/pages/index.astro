---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Hero from "@/features/hero/Hero.astro";
import ProjectsSection from "@/features/projects/ProjectsSection.astro";
import EducationSection from "@/features/education/EducationSection.astro";
import StackSection from "@/features/stack/StackSection.astro";
import { paths } from "@/shared/i18n/config";
---

<BaseLayout
  lang="es"
  title="Johel Andreé Vargas Villanueva"
  description="Web personal en construcción."
  alternates={{ es: paths.home("es"), en: paths.home("en") }}
  image={{ src: "/og/home-es.png", alt: "Johel Andreé Vargas Villanueva" }}
>
  <Hero lang="es" />
  <ProjectsSection lang="es" />
  <EducationSection lang="es" />
  <StackSection lang="es" />
</BaseLayout>
