---
import { Picture } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/shared/ui/Icon.astro";
import { SITE } from "@/shared/config/site";
import { paths, type Lang } from "@/shared/i18n/config";
import { useTranslations } from "@/shared/i18n/ui";
import {
  absolute,
  graph,
  personNode,
  sourceCodeNode,
  websiteNode,
} from "@/features/seo/structured-data";
import ProcessFlow from "./components/ProcessFlow.astro";
import ProjectCard from "./components/ProjectCard.astro";
import ProjectVisual from "./components/ProjectVisual.astro";
import { projectTag, projectsCopy, type Project } from "./lib/projects";

interface Props {
  lang: Lang;
  project: Project;
  previous: Project;
  next: Project;
  more: Project[];
  position: number;
  total: number;
}

const { lang, project, previous, next, more, position, total } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
const { data } = project;
const text = data[lang];
const copy = projectsCopy[lang];
const t = useTranslations(lang);
const site = Astro.site ?? new URL(`https://${SITE.domain}`);

const alternates = {
  es: paths.project("es", project.id),
  en: paths.project("en", project.id),
};
const url = absolute(alternates[lang], site);
// Search results truncate around 60 characters: add detail only while it fits.
const title = [
  `${data.name} — ${text.tagline} | ${SITE.shortName}`,
  `${data.name} — ${text.tagline}`,
  `${data.name} | ${SITE.shortName}`,
].find((candidate) => candidate.length <= 62)!;
const ogImage = `/og/${lang}/${project.id}.png`;
const host = (data.demo ?? data.repository)
  .replace(/^https?:\/\//, "")
  .replace(/\/$/, "");

const jsonLd = graph([
  personNode(lang, site),
  websiteNode(site),
  sourceCodeNode({
    lang,
    site,
    url,
    name: data.name,
    description: text.description,
    repository: data.repository,
    demo: data.demo,
    languages: data.languages,
    image: absolute(ogImage, site),
    team: data.team,
  }),
]);

// Numbered like the home sections; optional blocks shift the numbering.
const hasShot = Boolean(data.image && text.imageAlt);
const order = [
  "problem",
  "approach",
  ...(text.role ? ["role"] : []),
  ...(hasShot ? ["screen"] : []),
  "flow",
];
const num = (id: string) => String(order.indexOf(id) + 1).padStart(2, "0");
const legend = ["source", "process", "store", "output"] as const;
---

<BaseLayout
  lang={lang}
  title={title}
  description={text.description}
  alternates={alternates}
  image={{ src: ogImage, alt: `${data.name}: ${text.tagline}` }}
  type="article"
  jsonLd={jsonLd}
>
  <article class="case container" aria-labelledby="project-title">
    <!--
      The site is two levels deep, so instead of breadcrumbs (meant for deeper
      hierarchies) the page offers a way back plus its place in the series.
    -->
    <nav class="case-nav enter enter-1" aria-label={copy.caseNav}>
      <a class="case-nav__back" href={paths.section(lang, "projects")}>
        <Icon name="arrow-left" />
        {copy.all}
      </a>
      <div class="case-nav__pager">
        <a
          class="case-nav__arrow"
          href={paths.project(lang, previous.id)}
          rel="prev"
          title={previous.data.name}
        >
          <Icon name="arrow-left" />
          <span class="visually-hidden">
            {copy.previous}: {previous.data.name}
          </span>
        </a>
        <span class="case-nav__count mono">
          <span class="visually-hidden">{copy.positionLabel} </span>
          {pad(position)}
          <span aria-hidden="true"> / </span>
          <span class="visually-hidden">{copy.of}</span>
          {pad(total)}
        </span>
        <a
          class="case-nav__arrow"
          href={paths.project(lang, next.id)}
          rel="next"
          title={next.data.name}
        >
          <Icon name="arrow-right" />
          <span class="visually-hidden">
            {copy.next}: {next.data.name}
          </span>
        </a>
      </div>
    </nav>

    <header class="case__header">
      <div class="case__intro">
        <p class="case__eyebrow enter enter-2">
          <span class="case__tag">{projectTag(project)}</span>
          {text.kind}
        </p>
        <h1 id="project-title" class="case__title enter-move enter-2">
          {data.name}
        </h1>
        <p class="case__tagline enter enter-3">{text.tagline}</p>
        <p class="lead enter-move enter-3">{text.summary}</p>
      </div>

      <dl class="case__facts enter enter-4">
        <div>
          <dt>{copy.year}</dt>
          <dd>{data.year}</dd>
        </div>
        <div>
          <dt>{copy.type}</dt>
          <dd>{data.team ? copy.teamProject : copy.personalProject}</dd>
        </div>
        <div>
          <dt>{copy.languages}</dt>
          <dd>{data.languages.join(", ")}</dd>
        </div>
        <div>
          <dt>Demo</dt>
          <dd>{data.demo ? copy.demoPublic : copy.demoNone}</dd>
        </div>
      </dl>
    </header>

    <div class="enter-pop enter-4">
      <ProjectVisual project={project} lang={lang} size="hero" />
    </div>

    <div class="case__body">
      <div class="case__main">
        <section class="case__block" aria-labelledby="problem-title">
          <h2 id="problem-title">
            <span class="case__num" aria-hidden="true">
              {num("problem")}
            </span>
            {copy.problem}
          </h2>
          <p class="case__text">{text.problem}</p>
        </section>

        <section class="case__block" aria-labelledby="approach-title">
          <h2 id="approach-title">
            <span class="case__num" aria-hidden="true">
              {num("approach")}
            </span>
            {copy.approach}
          </h2>
          <ul class="case__steps" role="list">
            {text.approach.map((step) => (
              <li>{step}</li>
            ))}
          </ul>
        </section>

        {text.role && (
          <section class="case__block case__role" aria-labelledby="role-title">
            <h2 id="role-title">
              <span class="case__num" aria-hidden="true">
                {num("role")}
              </span>
              {copy.role}
            </h2>
            <p class="case__text">{text.role}</p>
          </section>
        )}

        {hasShot && data.image && (
          <section class="case__block" aria-labelledby="screen-title">
            <h2 id="screen-title">
              <span class="case__num" aria-hidden="true">
                {num("screen")}
              </span>
              {copy.screen}
            </h2>
            <figure class="case__shot">
              <div class="case__window" aria-hidden="true">
                <i />
                <i />
                <i />
                <span class="case__url">{host}</span>
              </div>
              <Picture
                src={data.image}
                alt={text.imageAlt ?? ""}
                formats={["avif", "webp"]}
                widths={[640, 960, 1280, 1600]}
                sizes="(min-width: 76rem) 48rem, calc(100vw - 2rem)"
                loading="lazy"
                decoding="async"
              />
              <figcaption>
                {data.demo ? copy.screenNote : copy.screenNoteRepo}
              </figcaption>
            </figure>
          </section>
        )}

        <section class="case__block" aria-labelledby="flow-title">
          <h2 id="flow-title">
            <span class="case__num" aria-hidden="true">
              {num("flow")}
            </span>
            {copy.architecture}
          </h2>
          <p class="case__note">{copy.architectureNote}</p>
          <figure class="case__flow">
            <ProcessFlow
              steps={data.flow}
              lang={lang}
              id={`${project.id}-large`}
              size="large"
            />
            <figcaption>
              <ul class="legend" role="list">
                {legend.map((type) => (
                  <li>
                    <span
                      class:list={["legend__swatch", `legend__swatch--${type}`]}
                      aria-hidden="true"
                    />
                    {copy.legend[type]}
                  </li>
                ))}
              </ul>
            </figcaption>
          </figure>
        </section>
      </div>

      <aside class="case__aside" aria-label={copy.details}>
        <div class="case__panel">
          <h2 class="case__panel-title">{copy.stack}</h2>
          <ul class="chip-list" role="list">
            {data.stack.map((item) => (
              <li class="chip">{item}</li>
            ))}
          </ul>
          <div class="case__actions">
            <a
              class="button button--primary"
              href={data.repository}
              target="_blank"
              rel="noopener"
            >
              <Icon name="code" />
              {copy.code}
              <span class="visually-hidden">{t("external.newTab")}</span>
            </a>
            {data.demo && (
              <a
                class="button button--ghost"
                href={data.demo}
                target="_blank"
                rel="noopener"
              >
                {copy.demo}
                <Icon name="arrow-up-right" />
                <span class="visually-hidden">{t("external.newTab")}</span>
              </a>
            )}
          </div>
          <p class="case__evidence">{copy.evidence}</p>
        </div>
        <a class="text-link case__back" href={paths.section(lang, "projects")}>
          <Icon name="arrow-left" />
          {copy.back}
        </a>
      </aside>
    </div>
  </article>

  <section class="more container" aria-labelledby="more-title">
    <h2 id="more-title" class="more__title">
      {copy.more}
    </h2>
    <ul class="more__grid" role="list">
      {more.map((other) => (
        <li>
          <ProjectCard project={other} lang={lang} />
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .case {
    padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3rem, 6vw, 5rem);
  }

  /* ----- Project bar: way back + place in the series ----- */
  .case-nav {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .case-nav__back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    font-weight: 650;
    white-space: nowrap;
    text-decoration: none;
    color: var(--text);
  }

  .case-nav__back :global(svg) {
    transition: transform var(--dur) var(--ease-out);
  }

  @media (prefers-reduced-motion: no-preference) {
    .case-nav__back:hover :global(svg) {
      transform: translateX(-3px);
    }
  }

  .case-nav__pager {
    display: inline-flex;
    flex: none;
    align-items: center;
    gap: clamp(0.4rem, 1.5vw, 0.75rem);
  }

  @media (max-width: 24rem) {
    .case-nav__count {
      position: absolute;
      inline-size: 1px;
      block-size: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }

  .case-nav__count {
    min-inline-size: 4.5ch;
    text-align: center;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .case-nav__arrow {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text);
    transition:
      background-color var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }

  .case-nav__arrow:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }

  /* ----- Header ----- */
  .case__header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(14rem, 20rem);
    align-items: end;
    gap: clamp(1.5rem, 4vw, 4rem);
    margin-block: clamp(2rem, 4vw, 3rem) clamp(1.75rem, 3vw, 2.5rem);
  }

  .case__intro {
    display: grid;
    gap: 1rem;
  }

  .case__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .case__tag {
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.375rem;
    color: var(--accent);
  }

  .case__title {
    font-size: var(--step-4);
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .case__tagline {
    font-size: var(--step-2);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: var(--chem);
  }

  /* Gradient text only where light-dark() works, see the hero name. */
  @supports (color: light-dark(#000, #fff)) {
    .case__tagline {
      background: linear-gradient(90deg, var(--chem), var(--accent));
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }

  @media (forced-colors: active) {
    .case__tagline {
      color: CanvasText;
      background: none;
    }
  }

  .case__facts {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .case__facts div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--step--1);
  }

  .case__facts dt {
    font-family: var(--font-mono);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .case__facts dd {
    font-weight: 650;
    text-align: end;
  }

  /* ----- Body ----- */
  .case__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 21rem);
    align-items: start;
    gap: clamp(2rem, 5vw, 5rem);
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .case__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 4vw, 3.5rem);
    min-inline-size: 0;
  }

  .case__block h2 {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin-bottom: 1rem;
    font-size: var(--step-2);
  }

  .case__num {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--accent);
  }

  .case__text {
    max-inline-size: 62ch;
    font-size: var(--step-1);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .case__steps {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .case__steps li {
    position: relative;
    padding: 1rem 0 1rem 2.25rem;
    border-bottom: 1px solid var(--line);
    color: var(--text-muted);
  }

  .case__steps li::before {
    content: "";
    position: absolute;
    left: 0.35rem;
    top: 1.55rem;
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border: 1.5px solid var(--accent);
    border-radius: 50%;
  }

  .case__role {
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border: 1px solid color-mix(in oklab, var(--chem) 40%, var(--line));
    border-radius: var(--radius-m);
    background: var(--chem-soft);
  }

  .case__role .case__num {
    color: var(--chem);
  }

  .case__role .case__text {
    color: var(--text);
  }

  .case__shot {
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--surface);
  }

  .case__window {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid var(--line);
  }

  .case__window i {
    inline-size: 0.6rem;
    block-size: 0.6rem;
    border-radius: 50%;
    background: var(--line-strong);
  }

  .case__url {
    margin-inline-start: 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .case__shot :global(img) {
    inline-size: 100%;
  }

  .case__shot figcaption {
    padding: 0.75rem 1rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .case__note {
    margin: -0.4rem 0 1rem;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .case__flow {
    padding: 1.5rem 1.25rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-m);
    background-color: var(--bg);
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 1.25rem 1.25rem;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin-top: 1rem;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .legend__swatch {
    inline-size: 1.1rem;
    block-size: 0.75rem;
    border: 1.5px solid;
    border-radius: 0.2rem;
  }

  .legend__swatch--source {
    border-color: var(--text-muted);
    clip-path: polygon(0 0, 70% 0, 100% 50%, 70% 100%, 0 100%);
  }

  .legend__swatch--process {
    border-color: var(--accent);
    background: var(--accent-soft);
  }

  .legend__swatch--store {
    border-color: var(--chem);
    background: var(--chem-soft);
    border-radius: 40% / 30%;
  }

  .legend__swatch--output {
    border-color: var(--text);
    background: var(--surface-2);
    clip-path: polygon(0 0, 70% 0, 100% 50%, 70% 100%, 0 100%);
  }

  /* ----- Aside ----- */
  .case__aside {
    position: sticky;
    top: calc(var(--header-h) + 1.5rem);
    display: grid;
    gap: 1.25rem;
  }

  .case__panel {
    display: grid;
    gap: 1.1rem;
    padding: 1.4rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
  }

  .case__panel-title {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .case__actions {
    display: grid;
    gap: 0.6rem;
  }

  .case__actions .button {
    white-space: normal;
    text-align: center;
  }

  .case__evidence {
    padding-top: 1rem;
    border-top: 1px solid var(--line);
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .case__back {
    justify-self: start;
  }

  /* ----- More projects ----- */
  .more {
    padding-block: clamp(3rem, 6vw, 5rem) var(--section-space);
    border-top: 1px solid var(--line);
  }

  .more__title {
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    font-size: var(--step-3);
  }

  .more__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2.5rem, 4vw, 3.5rem) clamp(1.25rem, 2.5vw, 2rem);
  }

  @media (max-width: 60rem) {
    .case__header,
    .case__body {
      grid-template-columns: minmax(0, 1fr);
    }

    .case__aside {
      position: static;
    }
  }

  @media (max-width: 52rem) {
    .more__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
