---
import Icon from "@/shared/ui/Icon.astro";
import { paths, type Lang } from "@/shared/i18n/config";
import ProjectVisual from "./ProjectVisual.astro";
import { projectsCopy, type Project } from "../lib/projects";

interface Props {
  project: Project;
  lang: Lang;
  /** Heading level: h3 inside the home section, h3 as well under "More projects". */
  headingLevel?: 2 | 3;
}

const { project, lang, headingLevel = 3 } = Astro.props;
const { data } = project;
const copy = projectsCopy[lang];
const text = data[lang];
const href = paths.project(lang, project.id);
const titleId = `card-${project.id}`;
const Heading = `h${headingLevel}` as "h2" | "h3";
---

<article class="project-card reveal" aria-labelledby={titleId}>
  <ProjectVisual project={project} lang={lang} />

  <div class="project-card__info">
    <div class="project-card__row">
      <Heading class="project-card__title" id={titleId}>
        <a href={href} data-astro-prefetch>
          {data.name}
        </a>
      </Heading>
      <span class="project-card__year mono">{data.year}</span>
    </div>
    <p class="project-card__text">{text.summary}</p>
    <div class="project-card__meta">
      <ul class="project-card__tags" role="list">
        {data.stack.slice(0, 4).map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      {data.team && (
        <span class="project-card__team">
          <Icon name="team" />
          {copy.team}
        </span>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 1.25rem;
    min-inline-size: 0;
  }

  .project-card :global(.visual) {
    transition: box-shadow var(--dur) ease;
  }

  .project-card:hover :global(.visual),
  .project-card:focus-within :global(.visual) {
    box-shadow: 0 1.5rem 3rem -1.75rem rgb(0 0 0 / 0.5);
  }

  .project-card__info {
    display: grid;
    gap: 0.6rem;
    padding-inline: 0.15rem;
  }

  .project-card__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-card__title {
    font-size: var(--step-2);
    letter-spacing: -0.035em;
  }

  .project-card__title a {
    text-decoration: none;
    transition: color var(--dur-fast) ease;
  }

  .project-card:hover .project-card__title a {
    color: var(--accent);
  }

  /* The whole card is clickable through the title link (one link, one tab stop). */
  .project-card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-m);
  }

  .project-card__title a:focus-visible {
    outline: none;
  }

  .project-card__title a:focus-visible::after {
    outline: 2px solid var(--focus);
    outline-offset: 6px;
  }

  .project-card__year {
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .project-card__text {
    max-inline-size: 60ch;
    color: var(--text-muted);
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-top: 0.15rem;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0;
    padding: 0;
    list-style: none;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .project-card__tags li + li::before {
    content: "/";
    padding-inline: 0.7rem;
    color: var(--text-subtle);
  }

  .project-card__team {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--chem-soft);
    color: var(--chem);
    font-size: var(--step--1);
    font-weight: 650;
  }
</style>
