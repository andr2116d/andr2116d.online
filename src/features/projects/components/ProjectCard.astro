---
import Icon from "@/shared/ui/Icon.astro";
import { paths, type Lang } from "@/shared/i18n/config";
import ProjectCover from "./ProjectCover.astro";
import { projectTag, projectsCopy, type Project } from "../lib/projects";

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const { data } = project;
const copy = projectsCopy[lang];
const text = data[lang];
const href = paths.project(lang, project.id);
const titleId = `card-${project.id}`;
---

<article class="project-card reveal" aria-labelledby={titleId}>
  <ProjectCover project={project} lang={lang} />

  <div class="project-card__body">
    <div class="project-card__meta">
      <span class="project-card__tag mono" aria-hidden="true">
        {projectTag(project)}
      </span>
      <span>{text.kind}</span>
      {data.team && (
        <span class="project-card__team">
          <Icon name="team" />
          {copy.team}
        </span>
      )}
    </div>

    <h3 class="project-card__title" id={titleId}>
      <a href={href} data-astro-prefetch>
        {data.name}
      </a>
    </h3>
    <p class="project-card__tagline">{text.summary}</p>

    <div class="project-card__foot">
      <ul class="chip-list" role="list">
        {data.stack.slice(0, 4).map((item) => (
          <li class="chip">{item}</li>
        ))}
      </ul>
      <span class="project-card__cta" aria-hidden="true">
        <Icon name="arrow-up-right" size="1.15rem" />
      </span>
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 1.25rem;
    padding: 0.75rem 0.75rem 1.25rem;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
    transition:
      border-color var(--dur) ease,
      box-shadow var(--dur) ease;
  }

  .project-card:hover,
  .project-card:focus-within {
    border-color: color-mix(in oklab, var(--accent) 60%, var(--line));
    box-shadow: 0 1.75rem 3.5rem -2.5rem
      color-mix(in oklab, var(--accent) 55%, transparent);
  }

  .project-card__body {
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    gap: 0.7rem;
    padding-inline: 0.75rem;
  }

  .project-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.75rem;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .project-card__tag {
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--line-strong);
    border-radius: 0.375rem;
    color: var(--accent);
  }

  .project-card__team {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--chem-soft);
    color: var(--chem);
    font-weight: 650;
  }

  .project-card__title {
    font-size: var(--step-2);
  }

  .project-card__title a {
    text-decoration: none;
  }

  /* The whole card is clickable through the title link (one link, one tab stop). */
  .project-card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .project-card__title a:focus-visible {
    outline: none;
  }

  .project-card__title a:focus-visible::after {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  .project-card__tagline {
    color: var(--text-muted);
  }

  .project-card__foot {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.4rem;
  }

  .project-card__cta {
    display: grid;
    place-items: center;
    flex: none;
    inline-size: 2.5rem;
    block-size: 2.5rem;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    color: var(--text);
    transition:
      background-color var(--dur) ease,
      color var(--dur) ease,
      border-color var(--dur) ease;
  }

  .project-card:hover .project-card__cta,
  .project-card:focus-within .project-card__cta {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-accent);
  }
</style>
