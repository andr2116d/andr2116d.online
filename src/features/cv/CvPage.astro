---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/shared/ui/Icon.astro";
import { SITE } from "@/shared/config/site";
import { paths, type Lang } from "@/shared/i18n/config";
import { useTranslations } from "@/shared/i18n/ui";
import { getProjects } from "@/features/projects/lib/projects";
import { institutions } from "@/features/education/education.content";
import { alsoUsed, elements, groups } from "@/features/stack/stack.content";
import {
  absolute,
  breadcrumbNode,
  graph,
  personNode,
  webPageNode,
  websiteNode,
} from "@/features/seo/structured-data";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const site = Astro.site ?? new URL(`https://${SITE.domain}`);
const projects = await getProjects();

const copy = {
  es: {
    title: `CV de ${SITE.name} | Química, Sistemas e IA`,
    description:
      "Perfil curricular de Johel Andreé Vargas Villanueva: formación en curso en Ingeniería Química (UNT) y Sistemas e IA (UPAO), proyectos y tecnologías.",
    heading: "Perfil curricular",
    role: "Desarrollador backend, frontend e IA · Estudiante de Ingeniería Química y de Sistemas e IA",
    print: "Imprimir o guardar PDF",
    printHint:
      "Para obtener un PDF, elige «Guardar como PDF» en el diálogo de impresión.",
    profile: "Perfil",
    summary:
      "Desarrollador autodidacta con formación en curso en dos ingenierías. Construyo productos web, APIs y herramientas de automatización, conectando el pensamiento en procesos de la ingeniería química con el desarrollo de software y la inteligencia artificial.",
    education: "Formación académica",
    ongoing: "En curso",
    projects: "Proyectos seleccionados",
    team: "En equipo",
    technologies: "Tecnologías",
    other: "Otras",
    interests: "Intereses",
    interestsText:
      "Desarrollo de productos, automatización de procesos, visualización de datos e inteligencia artificial aplicada.",
    updated: "Actualizado en octubre de 2026",
    portfolio: "Portafolio completo",
  },
  en: {
    title: `${SITE.name} CV | Chemical Eng., Systems & AI`,
    description:
      "Résumé of Johel Andreé Vargas Villanueva: Chemical Engineering (UNT) and Systems & AI (UPAO) studies in progress, projects and technologies.",
    heading: "Résumé",
    role: "Backend, frontend & AI developer · Chemical Engineering and Systems & AI student",
    print: "Print or save as PDF",
    printHint: "To get a PDF, choose “Save as PDF” in the print dialog.",
    profile: "Profile",
    summary:
      "Self-taught developer pursuing two engineering degrees. I build web products, APIs and automation tools, connecting chemical engineering’s process thinking with software development and artificial intelligence.",
    education: "Education",
    ongoing: "In progress",
    projects: "Selected projects",
    team: "Team",
    technologies: "Technologies",
    other: "Other",
    interests: "Interests",
    interestsText:
      "Product development, process automation, data visualization and applied artificial intelligence.",
    updated: "Updated October 2026",
    portfolio: "Full portfolio",
  },
}[lang];

const alternates = { es: paths.cv("es"), en: paths.cv("en") };
const url = absolute(alternates[lang], site);
const jsonLd = graph([
  personNode(lang, site),
  websiteNode(site),
  webPageNode({
    lang,
    site,
    url,
    title: copy.title,
    description: copy.description,
  }),
  breadcrumbNode([
    { name: t("nav.home"), url: absolute(paths.home(lang), site) },
    { name: copy.heading, url },
  ]),
]);

const stackByGroup = (Object.keys(groups) as (keyof typeof groups)[]).map(
  (group) => ({
    label: groups[group][lang],
    items: elements.filter((el) => el.group === group).map((el) => el.name),
  }),
);
const display = (href: string) =>
  href.replace(/^https?:\/\/(www\.)?/, "").replace(/\/$/, "");
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.description}
  alternates={alternates}
  image={{ src: `/og/${lang}/cv.png`, alt: copy.heading }}
  type="profile"
  jsonLd={jsonLd}
  bodyClass="cv-body"
>
  <div class="cv-toolbar container">
    <a class="text-link" href={paths.home(lang)}>
      <Icon name="arrow-left" />
      {t("nav.home")}
    </a>
    <button class="button button--ghost cv-print" type="button" data-print>
      <Icon name="print" />
      {copy.print}
    </button>
  </div>
  <p class="cv-hint container">{copy.printHint}</p>

  <article class="cv container" aria-labelledby="cv-name">
    <header class="cv__header">
      <p class="eyebrow">{copy.heading}</p>
      <h1 id="cv-name">{SITE.name}</h1>
      <p class="cv__role">{copy.role}</p>
      <ul class="cv__contact" role="list">
        <li>
          {SITE.location.city}, {lang === "es" ? "Perú" : "Peru"}
        </li>
        <li>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </li>
        <li>
          <a href={absolute("/", site)}>{SITE.domain}</a>
        </li>
        <li>
          <a href={SITE.links.github}>{display(SITE.links.github)}</a>
        </li>
        <li>
          <a href={SITE.links.linkedin}>
            linkedin.com/in/johel-andreé-vargas-villanueva
          </a>
        </li>
      </ul>
    </header>

    <section class="cv__section" aria-labelledby="cv-profile">
      <h2 id="cv-profile">{copy.profile}</h2>
      <p>{copy.summary}</p>
    </section>

    <section class="cv__section" aria-labelledby="cv-education">
      <h2 id="cv-education">{copy.education}</h2>
      <ul class="cv__entries" role="list">
        {institutions.map((institution) => (
          <li class="cv__entry">
            <div class="cv__entry-head">
              <h3>{institution.degree[lang]}</h3>
              <span class="cv__when mono">{copy.ongoing}</span>
            </div>
            <p>{institution.university}</p>
          </li>
        ))}
      </ul>
    </section>

    <section class="cv__section" aria-labelledby="cv-projects">
      <h2 id="cv-projects">{copy.projects}</h2>
      <ul class="cv__entries" role="list">
        {projects.map((project) => (
          <li class="cv__entry">
            <div class="cv__entry-head">
              <h3>
                <a href={paths.project(lang, project.id)}>
                  {project.data.name}
                </a>
              </h3>
              <span class="cv__when mono">
                {project.data.team ? `${copy.team} · ` : ""}
                {project.data.year}
              </span>
            </div>
            <p>{project.data[lang].summary}</p>
            {project.data[lang].role && (
              <p class="cv__role-note">{project.data[lang].role}</p>
            )}
            <p class="cv__meta mono">
              {project.data.stack.join(" · ")}
              <br />
              <a href={project.data.repository}>
                {display(project.data.repository)}
              </a>
            </p>
          </li>
        ))}
      </ul>
    </section>

    <section class="cv__section" aria-labelledby="cv-tech">
      <h2 id="cv-tech">{copy.technologies}</h2>
      <dl class="cv__tech">
        {stackByGroup.map((group) => (
          <div>
            <dt>{group.label}</dt>
            <dd>{group.items.join(", ")}</dd>
          </div>
        ))}
        <div>
          <dt>{copy.other}</dt>
          <dd>{alsoUsed.join(", ")}</dd>
        </div>
      </dl>
    </section>

    <section class="cv__section" aria-labelledby="cv-interests">
      <h2 id="cv-interests">{copy.interests}</h2>
      <p>{copy.interestsText}</p>
    </section>

    <footer class="cv__footer mono">
      <span>{copy.updated}</span>
      <a href={absolute(paths.home(lang), site)}>
        {copy.portfolio}: {SITE.domain}
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
  .cv-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 2rem;
  }

  :global(html:not([data-js])) .cv-print {
    display: none;
  }

  .cv-hint {
    margin-top: 0.75rem;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .cv {
    max-width: 52rem;
    margin-block: 2rem var(--section-space);
    padding: clamp(1.5rem, 5vw, 3.5rem);
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: var(--surface);
  }

  .cv__header {
    display: grid;
    gap: 0.75rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  .cv__header h1 {
    font-size: var(--step-3);
  }

  .cv__role {
    font-size: var(--step-1);
    color: var(--text-muted);
  }

  .cv__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .cv__contact a {
    color: var(--text);
  }

  .cv__section {
    display: grid;
    gap: 0.9rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  .cv__section h2 {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .cv__section p {
    color: var(--text-muted);
  }

  .cv__entries {
    display: grid;
    gap: 1.4rem;
  }

  .cv__entry {
    display: grid;
    gap: 0.3rem;
    break-inside: avoid;
  }

  .cv__entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1rem;
  }

  .cv__entry h3 {
    font-size: var(--step-1);
    letter-spacing: -0.02em;
  }

  .cv__entry h3 a {
    text-decoration: none;
  }

  .cv__when {
    font-size: var(--step--1);
    color: var(--text-subtle);
  }

  .cv__role-note {
    font-style: italic;
  }

  .cv__meta {
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .cv__tech {
    display: grid;
    gap: 0.6rem;
  }

  .cv__tech div {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: 1rem;
  }

  .cv__tech dt {
    font-weight: 650;
  }

  .cv__tech dd {
    color: var(--text-muted);
  }

  .cv__footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    padding-top: 1.5rem;
    font-size: 0.875rem;
    color: var(--text-subtle);
  }

  @media (max-width: 36rem) {
    .cv__tech div {
      grid-template-columns: 1fr;
      gap: 0.1rem;
    }
  }

  /* ----- A4 print ----- */
  @page {
    size: A4;
    margin: 14mm 15mm;
  }

  @media print {
    :global(.cv-body .site-header),
    :global(.cv-body .site-footer),
    :global(.cv-body .skip-link),
    .cv-toolbar,
    .cv-hint {
      display: none !important;
    }

    :global(.cv-body) {
      background: #fff !important;
      color: #000;
      font-size: 10.5pt;
      line-height: 1.45;
    }

    .cv {
      width: auto;
      max-width: none;
      margin: 0;
      padding: 0;
      border: 0;
      background: none;
    }

    .cv__header h1 {
      font-size: 22pt;
    }

    .cv__role,
    .cv__section p,
    .cv__tech dd,
    .cv__contact,
    .cv__when,
    .cv__footer {
      color: #222 !important;
    }

    .cv__section h2 {
      color: #3c2766 !important;
    }

    .cv__section,
    .cv__header {
      border-color: #ccc;
      padding-block: 10pt;
    }

    .cv a {
      color: #000 !important;
      text-decoration: none;
    }

    .cv__section h2 {
      break-after: avoid;
    }

    .cv__meta {
      font-size: 8.5pt;
    }
  }
</style>

<script>
  document
    .querySelector("[data-print]")
    ?.addEventListener("click", () => window.print());
</script>
