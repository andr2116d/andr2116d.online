---
/**
 * One-page A4 CV, identical on screen, in print and in the generated PDF.
 * Built for recruiters and applicant tracking systems: single column, standard
 * section titles, real text (no icons or graphics carrying data), visible URLs,
 * action-verb bullets and reverse-chronological, verifiable content only.
 */
import { Font } from "astro:assets";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/shared/ui/Icon.astro";
import { SITE } from "@/shared/config/site";
import { paths, type Lang } from "@/shared/i18n/config";
import { useTranslations } from "@/shared/i18n/ui";
import { getProjects } from "@/features/projects/lib/projects";
import { institutions } from "@/features/education/education.content";
import {
  absolute,
  breadcrumbNode,
  graph,
  personNode,
  webPageNode,
  websiteNode,
} from "@/features/seo/structured-data";
import { cvCopy, cvExtras, cvPdf, cvSkills } from "./cv.content";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = cvCopy[lang];
const t = useTranslations(lang);
const site = Astro.site ?? new URL(`https://${SITE.domain}`);
const projects = await getProjects();

const alternates = { es: paths.cv("es"), en: paths.cv("en") };
const url = absolute(alternates[lang], site);
const jsonLd = graph([
  personNode(lang, site),
  websiteNode(site),
  webPageNode({
    lang,
    site,
    url,
    title: copy.title,
    description: copy.description,
  }),
  breadcrumbNode([
    { name: t("nav.home"), url: absolute(paths.home(lang), site) },
    { name: copy.pageLabel, url },
  ]),
]);

const bare = (href: string) =>
  decodeURI(href)
    .replace(/^https?:\/\/(www\.)?/, "")
    .replace(/\/$/, "");

// Two deliberate lines (person, then links) so no separator is left dangling.
const contactLines = [
  [
    { text: copy.location },
    { text: SITE.email, href: `mailto:${SITE.email}` },
    ...(cvExtras.phone
      ? [
          {
            text: cvExtras.phone,
            href: `tel:${cvExtras.phone.replace(/\s/g, "")}`,
          },
        ]
      : []),
  ],
  [
    { text: SITE.domain, href: absolute(paths.home(lang), site) },
    { text: bare(SITE.links.github), href: SITE.links.github },
    { text: bare(SITE.links.linkedin), href: SITE.links.linkedin },
  ],
];

const studies = institutions.map((institution) => {
  const extra = cvExtras.studies[institution.id];
  const period = extra.start
    ? `${extra.start} – ${extra.expected ? `${copy.expected} ${extra.expected}` : copy.ongoing}`
    : copy.ongoing;
  return { institution, period, cycle: extra.cycle?.[lang] };
});
---

<BaseLayout
  lang={lang}
  title={copy.title}
  description={copy.description}
  alternates={alternates}
  image={{ src: `/og/${lang}/cv.png`, alt: copy.pageLabel }}
  type="profile"
  jsonLd={jsonLd}
  bodyClass="cv-body"
>
  <Font slot="head" cssVariable="--font-cv" />
  <div class="cv-toolbar container">
    <div class="cv-toolbar__intro">
      <a class="text-link" href={paths.home(lang)}>
        <Icon name="arrow-left" />
        {t("nav.home")}
      </a>
      <p class="cv-toolbar__hint">{copy.hint}</p>
    </div>
    <div class="cv-toolbar__actions">
      <a
        class="button button--primary"
        href={cvPdf[lang]}
        download
        type="application/pdf"
      >
        <Icon name="arrow-down" />
        {copy.download}
      </a>
      <button class="button button--ghost cv-print" type="button" data-print>
        <Icon name="print" />
        {copy.print}
      </button>
    </div>
  </div>

  <div class="cv-stage">
    <article class="sheet" aria-labelledby="cv-name">
      <header class="sheet__head">
        <h1 id="cv-name" class="sheet__name">
          {SITE.name}
        </h1>
        <p class="sheet__headline">{copy.headline}</p>
        {contactLines.map((line) => (
          <ul class="sheet__contact" role="list">
            {line.map((item) => (
              <li>
                {item.href ? <a href={item.href}>{item.text}</a> : item.text}
              </li>
            ))}
          </ul>
        ))}
      </header>

      <section class="sheet__section" aria-labelledby="cv-summary">
        <h2 id="cv-summary">{copy.summaryTitle}</h2>
        <p>{copy.summary}</p>
      </section>

      <section class="sheet__section" aria-labelledby="cv-education">
        <h2 id="cv-education">{copy.educationTitle}</h2>
        {studies.map(({ institution, period, cycle }) => (
          <div class="sheet__entry">
            <div class="sheet__row">
              <h3>{institution.degree[lang]}</h3>
              <span class="sheet__date">{period}</span>
            </div>
            <p class="sheet__sub">
              {institution.university} · {copy.location}
              {cycle && ` · ${cycle}`}
            </p>
          </div>
        ))}
      </section>

      <section class="sheet__section" aria-labelledby="cv-projects">
        <h2 id="cv-projects">{copy.projectsTitle}</h2>
        {projects.map((project) => {
          const text = project.data[lang];
          return (
            <div class="sheet__entry">
              <div class="sheet__row">
                <h3>
                  <a href={absolute(paths.project(lang, project.id), site)}>
                    {project.data.name}
                  </a>
                  <span class="sheet__kind"> — {text.tagline}</span>
                </h3>
                <span class="sheet__date">
                  {project.data.team ? `${copy.team} · ` : ""}
                  {project.data.year}
                </span>
              </div>
              <ul class="sheet__bullets">
                {text.highlights.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
              <p class="sheet__tech">
                {project.data.stack.slice(0, 6).join(", ")} ·{" "}
                <a href={project.data.repository}>
                  {bare(project.data.repository)}
                </a>
              </p>
            </div>
          );
        })}
      </section>

      <section class="sheet__section" aria-labelledby="cv-skills">
        <h2 id="cv-skills">{copy.skillsTitle}</h2>
        {cvSkills.map((skill) => (
          <p class="sheet__skill">
            <strong>{skill.group[lang]}:</strong> {skill.items}
          </p>
        ))}
      </section>

      {cvExtras.languages.length > 0 && (
        <section class="sheet__section" aria-labelledby="cv-languages">
          <h2 id="cv-languages">{copy.languagesTitle}</h2>
          <p>
            {cvExtras.languages
              .map((l) => `${l.name[lang]}: ${l.level[lang]}`)
              .join(" · ")}
          </p>
        </section>
      )}

      {cvExtras.certifications.length > 0 && (
        <section class="sheet__section" aria-labelledby="cv-certs">
          <h2 id="cv-certs">{copy.certificationsTitle}</h2>
          <ul class="sheet__bullets">
            {cvExtras.certifications.map((c) => (
              <li>
                {c.name} — {c.issuer}, {c.year}
              </li>
            ))}
          </ul>
        </section>
      )}

      <p class="sheet__foot">
        {copy.portfolio}:{" "}
        <a href={absolute(paths.home(lang), site)}>{SITE.domain}</a> ·{" "}
        {copy.updated}
      </p>
    </article>
  </div>
</BaseLayout>

<style>
  /* ---------- Screen: toolbar + paper on the desk ---------- */
  .cv-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .cv-toolbar__intro {
    display: grid;
    gap: 0.4rem;
  }

  .cv-toolbar__hint {
    font-size: var(--step--1);
    color: var(--text-muted);
  }

  .cv-toolbar__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  :global(html:not([data-js])) .cv-print {
    display: none;
  }

  .cv-stage {
    padding: clamp(1.25rem, 3vw, 2.5rem) var(--gutter) var(--section-space);
  }

  /*
   * The sheet is a document, so it stays paper-white in both themes and uses its
   * own fixed ink colors (all ≥ 7:1 on white).
   */
  .sheet {
    --ink: #1b1922;
    --ink-2: #3f3a48;
    --ink-3: #5b5566;
    --rule: #dcd8e3;
    --brand: #4b2f7d;
    position: relative;
    box-sizing: border-box;
    inline-size: min(100%, 210mm);
    min-block-size: 297mm;
    margin-inline: auto;
    padding: 11mm 14mm 9mm;
    border-radius: 0.35rem;
    background: #fff;
    color: var(--ink);
    font-family: var(--font-cv);
    font-size: 9.5pt;
    line-height: 1.33;
    /* Manrope's narrow space is below PDF extractors' gap threshold: without this,
       applicant tracking systems read words glued together. */
    word-spacing: 0.1em;
    box-shadow:
      0 0 0 1px rgb(0 0 0 / 0.06),
      0 2rem 4rem -1.5rem rgb(0 0 0 / 0.45);
    overflow-wrap: break-word;
  }

  /* Brand accent: decorative only, carries no information. */
  .sheet::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    block-size: 4px;
    border-radius: 0.35rem 0.35rem 0 0;
    background: linear-gradient(90deg, #17694f, #5a3990);
  }

  .sheet a {
    color: inherit;
    text-decoration: none;
  }

  .sheet a:hover {
    text-decoration: underline;
  }

  .sheet__head {
    display: grid;
    gap: 0.25em;
    padding-bottom: 0.6em;
  }

  .sheet__name {
    font-size: 2.25em;
    font-weight: 800;
    /* Mild tracking: tighter values make PDF text extraction split the words. */
    letter-spacing: -0.01em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .sheet__headline {
    font-size: 1.05em;
    font-weight: 500;
    color: var(--ink-2);
  }

  .sheet__contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.15em 0;
    font-size: 0.9em;
    color: var(--ink-2);
  }

  /* WCAG 2.5.8: 24px tall targets on screen; print keeps the compact line. */
  @media screen {
    .sheet__contact a {
      display: inline-flex;
      align-items: center;
      min-block-size: 24px;
    }
  }

  .sheet__contact li + li::before {
    content: "·";
    padding-inline: 0.55em;
    color: var(--ink-3);
  }

  .sheet__section {
    padding-top: 0.6em;
  }

  .sheet__section h2 {
    margin-bottom: 0.45em;
    padding-bottom: 0.2em;
    border-bottom: 1px solid var(--rule);
    font-size: 0.8em;
    font-weight: 700;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--brand);
  }

  .sheet__section > p {
    color: var(--ink-2);
  }

  .sheet__entry {
    break-inside: avoid;
  }

  .sheet__entry + .sheet__entry {
    margin-top: 0.45em;
  }

  .sheet__row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0 1em;
  }

  .sheet__row h3 {
    font-size: 1.02em;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .sheet__kind {
    font-weight: 400;
    color: var(--ink-2);
  }

  .sheet__date {
    font-size: 0.88em;
    font-weight: 500;
    color: var(--ink-3);
    white-space: nowrap;
  }

  .sheet__sub {
    color: var(--ink-2);
  }

  .sheet__bullets {
    margin-top: 0.15em;
    padding-left: 1.15em;
    color: var(--ink-2);
  }

  .sheet__bullets li {
    padding-left: 0.15em;
  }

  .sheet__bullets li::marker {
    color: var(--brand);
  }

  .sheet__tech {
    margin-top: 0.1em;
    font-size: 0.86em;
    color: var(--ink-3);
  }

  .sheet__skill {
    color: var(--ink-2);
  }

  .sheet__skill + .sheet__skill {
    margin-top: 0.15em;
  }

  .sheet__skill strong {
    color: var(--ink);
    font-weight: 700;
  }

  .sheet__foot {
    margin-top: 0.8em;
    padding-top: 0.45em;
    border-top: 1px solid var(--rule);
    font-size: 0.82em;
    color: var(--ink-3);
  }

  /* Wide screens: enlarge the page like a PDF viewer would, layout unchanged. */
  @media screen and (min-width: 64rem) {
    .sheet {
      zoom: 1.12;
    }
  }

  @media screen and (min-width: 100rem) {
    .sheet {
      zoom: 1.22;
    }
  }

  /* Phones (screen only: an A4 page is also narrower than 52rem). */
  @media screen and (max-width: 52rem) {
    .cv-stage {
      padding-inline: 0.75rem;
    }

    .sheet {
      min-block-size: 0;
      padding: 1.5rem 1.15rem 1.25rem;
      font-size: 0.875rem;
    }

    .sheet__row {
      display: grid;
    }

    .sheet__contact {
      display: grid;
    }

    .sheet__contact li + li::before {
      content: none;
    }
  }

  /* ---------- Print & PDF: the sheet is the page ---------- */
  @page {
    size: A4;
    margin: 0;
  }

  @media print {
    :global(html) {
      font-size: 100% !important;
    }

    :global(.cv-body) {
      background: #fff !important;
    }

    :global(.cv-body .site-header),
    :global(.cv-body .site-footer),
    :global(.cv-body .skip-link),
    .cv-toolbar {
      display: none !important;
    }

    .cv-stage {
      padding: 0;
    }

    .sheet {
      inline-size: 210mm;
      min-block-size: 0;
      block-size: 297mm;
      margin: 0;
      border-radius: 0;
      box-shadow: none;
      overflow: hidden;
      print-color-adjust: exact;
      -webkit-print-color-adjust: exact;
    }

    .sheet::before {
      border-radius: 0;
    }

    .sheet a:hover {
      text-decoration: none;
    }
  }
</style>

<script>
  document
    .querySelector("[data-print]")
    ?.addEventListener("click", () => window.print());
</script>
